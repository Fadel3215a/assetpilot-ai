# PostgreSQL connection used by Prisma (see docker-compose.yml for local dev).
# For hosted Neon, use the DIRECT (non-pooled) endpoint so migrations can create
# their shadow database: host WITHOUT the "-pooler" suffix.
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Gemini API key for real AI analysis. Leave empty to fall back to the built-in
# mock provider, which generates deterministic analysis from metadata alone.
GEMINI_API_KEY=""

# NextAuth/Auth.js (Stage 3.1) — JWT signing secret for the Credentials login.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Trust the deployment's host header (needed when not on localhost:3000).
AUTH_TRUST_HOST="true"

# Redis / BullMQ background-jobs infrastructure (Stage 1.1).
# Provide a full URL, or the host/port pair below. Leave unset to run with a
# mock connection (queue infra imports safely, but jobs will not be processed
# until a live Redis is configured).
REDIS_URL=""
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""
# REDIS_DB=0

# Object storage (Stage 2.1) — AWS S3 or S3-compatible stores (Cloudflare R2).
# Leave all S3_* unset to fall back to the local filesystem adapter, which
# operates on the `storage/uploads/` directory.
S3_BUCKET_NAME=""
S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# Cloudflare R2 template: set the endpoint to your bucket's S3 API URL, region
# to "auto", and credentials to the R2 access key / secret pair.
# S3_BUCKET_NAME="my-assetpilot-bucket"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="<r2-access-key-id>"
# S3_SECRET_ACCESS_KEY="<r2-secret-access-key>"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
